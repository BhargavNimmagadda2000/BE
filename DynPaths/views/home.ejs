<%- include('./partials/head') %>
  </head>
  <body>
    <%- include('./partials/nav') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">Hey Host! Here are your homes:</h2>
      <div class="flex flex-wrap justify-center gap-6">
        <% registeredHomes.forEach(home => { %>
          <div class="bg-white rounded-xl shadow-md overflow-hidden w-full max-w-[320px] border border-gray-200 hover:shadow-lg transition duration-300">
            <% if (home.photoUrl) { %>
              <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="home-thumb w-full h-28 object-cover block">
            <% } %>
            <div class="p-4">
              <h3 class="text-lg font-semibold text-gray-900 mb-1"><%= home.houseName %></h3>
              <p class="text-gray-600 text-sm mb-2"><%= home.location %></p>
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-red-500">Rs<%= home.price %> / night</span>
                <div class="flex items-center gap-2 text-gray-700">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-yellow-400">
                    </svg>
                  <span class="text-sm font-medium"><%= home.rating %></span>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>