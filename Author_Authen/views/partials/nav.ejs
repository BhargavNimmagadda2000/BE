<header class="bg-white border-b border-gray-200 sticky top-0 z-20 shadow-sm">
  <nav class="container mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
    <a
      href="/"
      class="text-2xl font-bold text-red-500 tracking-tight <%= currentPage === 'index' ? '' : 'hover:text-red-600' %>"
      >airbnb</a
    >
    <ul class="flex flex-wrap items-center gap-1">
      <% if (isLoggedIn) { %>
      <li>
        <a
          href="/homes"
          class="<%= currentPage === 'Home' ? 'bg-red-50 text-red-500' : 'text-gray-600 hover:bg-gray-100' %> py-2 px-3 rounded-lg text-sm font-medium transition"
          >Homes-List</a
        >
      </li>
      <li>
        <a
          href="/favourites"
          class="<%= currentPage === 'favourites' ? 'bg-red-50 text-red-500' : 'text-gray-600 hover:bg-gray-100' %> py-2 px-3 rounded-lg text-sm font-medium transition"
          >Favourites</a
        >
      </li>
      <li>
        <a
          href="/bookings"
          class="<%= currentPage === 'bookings' ? 'bg-red-50 text-red-500' : 'text-gray-600 hover:bg-gray-100' %> py-2 px-3 rounded-lg text-sm font-medium transition"
          >Bookings</a
        >
      </li>
      <li>
        <a
          href="/host/host-home-list"
          class="<%= currentPage === 'host-homes' ? 'bg-red-50 text-red-500' : 'text-gray-600 hover:bg-gray-100' %> py-2 px-3 rounded-lg text-sm font-medium transition"
          >Host Homes</a
        >
      </li>
      <li>
        <a
          href="/host/add-home"
          class="<%= currentPage === 'add-home' ? 'bg-red-50 text-red-500' : 'text-gray-600 hover:bg-gray-100' %> py-2 px-3 rounded-lg text-sm font-medium transition"
          >Add Home</a
        >
      </li>
      <% } %>
      <% if (!isLoggedIn) { %>
      <li>
        <a
          href="/signup"
          class="<%= currentPage === 'signup' ? 'bg-red-50 text-red-500' : 'text-gray-600 hover:bg-gray-100' %> py-2 px-3 rounded-lg text-sm font-medium transition"
          >Signup</a
        >
      </li>
      <li>
        <a
          href="/login"
          class="<%= currentPage === 'login' ? 'bg-red-500 text-white hover:bg-red-600' : 'bg-red-500 text-white hover:bg-red-600' %> py-2 px-4 rounded-lg text-sm font-medium transition"
          >Login</a
        >
      </li>
      <% } else { %>
      <li>
        <form action="/logout" method="POST">
          <button type="submit" class="<%= currentPage === 'logout' ? 'bg-gray-100 text-gray-800' : 'text-gray-600 hover:bg-gray-100' %> py-2 px-3 rounded-lg text-sm font-medium transition">Logout</button>
        </form>
      </li>
      <% } %>
    </ul>
  </nav>
</header>
