<%- include('../partials/head') %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <%- include('../partials/nav') %>
      <main class="container mx-auto px-4 py-10 max-w-6xl">
        <h2 class="text-3xl font-bold text-gray-800 text-center">
          Available homes
        </h2>
        <p class="text-gray-500 text-center mt-2 mb-8">Browse places you can book</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% registeredHomes.forEach(home=> { %>
            <div
              class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition duration-300">
              <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-52 object-cover bg-gray-200">
              <div class="p-5">
                <h3 class="text-lg font-semibold text-gray-800 mb-1">
                  <%= home.houseName %>
                </h3>
                <p class="text-gray-500 text-sm mb-3">
                  <%= home.location %>
                </p>
                <div class="flex justify-between items-center mb-4">
                  <span class="text-base font-bold text-red-500">Rs<%= home.price %> <span class="text-sm font-medium text-gray-500">/ night</span></span>
                  <div class="flex items-center">
                    <img src="/icons/star.svg" alt="star" width="16" height="16" class="inline-block align-middle mr-1">
                    <span class="text-gray-700 text-sm">
                      <%= home.rating %>
                    </span>
                  </div>
                </div>
                <a href="/home/<%= home._id %>" class="block text-center bg-red-500 text-white py-2 rounded-lg font-medium hover:bg-red-600 transition mb-3">Details</a>
                <div>
                  <%- include('../partials/favourite', { home: home }) %>
                </div>
              </div>
            </div>
            <% }) %>
        </div>
      </main>
    </body>

  </html>
