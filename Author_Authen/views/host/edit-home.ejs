<%- include('../partials/head') %>
  </head>
  <body class="form-page">
    <%- include('../partials/nav') %>
    <main class="form-shell">
      <div class="form-card">
        <h1 class="form-title"><%= editing ? 'Update your home' : 'List your home' %></h1>
        <p class="form-subtitle"><%= editing ? 'Edit the details for this listing' : 'Share your space with guests on Airbnb' %></p>
        <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" class="space-y-5">
          <% if (editing) { %>
            <input type="hidden" name="id" value="<%= home._id %>"/>
          <% } %>
          <div>
            <label for="houseName" class="form-label">House name</label>
            <input
              type="text"
              id="houseName"
              name="houseName"
              placeholder="Cozy downtown loft"
              value="<%= editing ? home.houseName : '' %>"
              required
              class="form-input"/>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="price" class="form-label">Price per night</label>
              <input
                type="text"
                id="price"
                name="price"
                placeholder="2500"
                value="<%= editing ? home.price : '' %>"
                required
                class="form-input"/>
            </div>
            <div>
              <label for="rating" class="form-label">Rating</label>
              <input
                type="text"
                id="rating"
                name="rating"
                placeholder="4.8"
                value="<%= editing ? home.rating : '' %>"
                required
                class="form-input"/>
            </div>
          </div>
          <div>
            <label for="location" class="form-label">Location</label>
            <input
              type="text"
              id="location"
              name="location"
              placeholder="Hyderabad, India"
              value="<%= editing ? home.location : '' %>"
              required
              class="form-input"/>
          </div>
          <div>
            <label for="photoUrl" class="form-label">Photo URL</label>
            <input
              type="text"
              id="photoUrl"
              name="photoUrl"
              placeholder="https://example.com/photo.jpg"
              value="<%= editing ? home.photoUrl : '' %>"
              required
              class="form-input"/>
          </div>
          <div>
            <label for="description" class="form-label">Description</label>
            <textarea
              id="description"
              name="description"
              rows="4"
              placeholder="Tell guests what makes this place special"
              class="form-input resize-y"><%= editing ? home.description : '' %></textarea>
          </div>
          <input type="submit" value="<%= editing ? 'Update Home' : 'Add Home' %>" class="form-button" />
        </form>
      </div>
    </main>
  </body>
</html>
