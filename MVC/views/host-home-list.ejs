<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
        Hey Host! Here are your homes:
      </h2>
      <div class="flex flex-wrap justify-center gap-10">
        <% registeredHomes.forEach(home => { %>
          <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-200 hover:shadow-lg transition duration-300" style="flex:0 0 320px;max-width:320px;margin-right:24px">
            <% if (home.photoUrl) { %>
              <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="home-thumb w-full h-28 object-cover block" style="height:112px;object-fit:cover;">
            <% } %>
            <div class="p-4">
              <h3 class="text-lg font-semibold text-gray-900 mb-1"><%= home.houseName %></h3>
              <p class="text-gray-600 text-sm mb-2"><%= home.location %></p>
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-gray-800">Rs<%= home.price %> / night</span>
                <div class="flex items-center gap-2 text-gray-700">
                  <img src="/icons/star.svg" alt="star" width="20" height="20" class="inline-block align-middle mr-1">
                  <span class="font-semibold"><%= home.rating %></span>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>